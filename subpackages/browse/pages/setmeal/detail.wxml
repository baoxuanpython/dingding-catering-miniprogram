<navigation-bar title="套餐详情" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <view wx:if="{{setmeal}}">
    <image src="{{setmeal.image}}" mode="aspectWidthFix" class="setmeal-image"></image>
    <view class="setmeal-info">
      <text class="setmeal-name">{{setmeal.name}}</text>
      <text class="setmeal-price">¥{{setmeal.price}}</text>
      <text class="setmeal-desc">{{setmeal.description}}</text>
    </view>
    
    <view class="dishes-section">
      <text class="section-title">套餐包含</text>
      <view wx:for="{{setmeal.setmealDishes}}" wx:key="id" class="dish-item">
        <text class="dish-name">{{item.name}} × {{item.copies}}</text>
        <view wx:for="{{item.setmealDishFlavors}}" wx:key="id" class="flavor-tag">
          {{item.flavorName}}：{{item.flavorValue}}
        </view>
      </view>
    </view>
    
    <view class="bottom-bar">
      <view class="quantity-control">
        <text class="qty-btn">-</text>
        <text>{{quantity}}</text>
        <text class="qty-btn">+</text>
      </view>
      <button class="add-cart-btn">加入购物车</button>
    </view>
  </view>
</view>
