<navigation-bar title="菜品详情" color="#1a3a2a" background="#FFF"></navigation-bar>
<view class="container">
  <view wx:if="{{loadFailed}}" class="load-failed">
    <text class="load-failed-text">菜品信息加载失败</text>
    <view class="load-failed-btn" bindtap="onBack">返回重新选择</view>
  </view>

  <scroll-view wx:if="{{dish}}" class="scroll-area" scroll-y enhanced bounces>
    <image src="{{dish.image}}" mode="widthFix" class="dish-image"></image>
    <view class="dish-info">
      <text class="dish-name">{{dish.name}}</text>
      <text class="dish-price">¥{{dish.price}}</text>
      <text class="dish-desc">{{dish.description || '暂无描述'}}</text>
    </view>

    <view wx:if="{{flavorGroups.length > 0}}" class="flavor-section">
      <text class="section-title">选择口味</text>
      <view wx:for="{{flavorGroups}}" wx:key="flavorId" class="flavor-group">
        <text class="flavor-name">{{item.name}}</text>
        <view class="flavor-values">
          <view
            wx:for="{{item.values}}"
            wx:for-item="value"
            wx:for-index="vi"
            wx:key="*this"
            class="flavor-chip {{vi === item.selectedIndex ? 'active' : ''}}"
            bindtap="onSelectFlavor"
            data-fid="{{item.flavorId}}"
            data-vi="{{vi}}"
          >{{value}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{dish}}" class="bottom-bar">
    <view class="quantity-control">
      <view class="qty-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="onMinus">-</view>
      <text class="qty-value">{{quantity}}</text>
      <view class="qty-btn" bindtap="onPlus">+</view>
    </view>
    <view class="add-cart-btn {{adding ? 'disabled' : ''}}" bindtap="onAddToCart">加入购物车</view>
  </view>
</view>
