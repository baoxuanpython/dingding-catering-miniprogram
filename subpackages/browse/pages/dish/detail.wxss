.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: 120rpx;
}
.dish-image {
  width: 100%;
  height: 500rpx;
}
.dish-info {
  padding: 30rpx;
}
.dish-name {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}
.dish-price {
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}
.dish-desc {
  font-size: 26rpx;
  color: #666666;
}
.flavor-section {
  padding: 30rpx;
  border-top: 1rpx solid #eeeeee;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
  font-size: 32rpx;
}
.add-cart-btn {
  background-color: #ff6b35;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
}
