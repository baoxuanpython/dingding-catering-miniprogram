.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}
.status-bar {
  background-color: #ff6b35;
  padding: 30rpx;
  text-align: center;
}
.status-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}
.address-card {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}
.consignee {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}
.address {
  font-size: 26rpx;
  color: #666666;
  display: block;
}
.order-items {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eeeeee;
}
.item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.item-name {
  font-size: 28rpx;
  color: #333333;
}
.item-quantity {
  font-size: 24rpx;
  color: #999999;
}
.item-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: bold;
  text-align: right;
}
.flavor-list {
  margin-top: 8rpx;
  padding-left: 140rpx;
}
.flavor-tag {
  font-size: 22rpx;
  color: #999999;
  margin-right: 16rpx;
  display: inline-block;
}
.order-summary {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
}
.row.total {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b35;
  border-top: 1rpx solid #eeeeee;
  margin-top: 12rpx;
  padding-top: 20rpx;
}
.action-buttons {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  padding: 0 30rpx;
  margin-top: 30rpx;
}
