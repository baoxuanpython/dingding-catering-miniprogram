<navigation-bar title="确认订单" color="#1a3a2a" background="#FFF"></navigation-bar>
<view class="container">
  <view wx:if="{{loadFailed}}" class="page-loading state-retry" bindtap="onRetryLoad">加载失败，点击重试</view>

  <view wx:elif="{{loading}}" class="page-loading">加载中...</view>

  <view wx:elif="{{cartList.length === 0 && orderCreated}}" class="empty-state">
    <text class="empty-text">订单已提交</text>
    <view class="empty-btn" bindtap="onGoOrderList">查看订单</view>
  </view>

  <view wx:elif="{{cartList.length === 0 && !submitting}}" class="empty-state">
    <text class="empty-text">购物车是空的</text>
    <view class="empty-btn" bindtap="onGoShopping">去逛逛</view>
  </view>

  <block wx:else>
    <scroll-view class="scroll-area" scroll-y enhanced bounces>
    <view class="address-section" bindtap="onTapSelectAddress">
      <view wx:if="{{address}}">
        <text class="consignee">{{address.consignee}} {{address.phone}}</text>
        <text class="address-detail">{{address.provinceName}}{{address.cityName}}{{address.districtName}}{{address.detail}}</text>
      </view>
      <view wx:else>
        <text class="placeholder">请选择收货地址</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="section">
      <text class="section-title">商品清单</text>
      <view wx:for="{{cartList}}" wx:key="id" class="cart-item">
        <image class="item-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text wx:if="{{item.flavorText}}" class="item-flavor">{{item.flavorText}}</text>
          <view class="item-bottom">
            <text class="item-price">¥{{item.lineAmountText}}</text>
            <text class="item-count">× {{item.number}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">配送方式</text>
      <view class="option-row">
        <view
          class="option-chip {{deliveryStatus === 1 ? 'active' : ''}}"
          bindtap="onSelectDelivery"
          data-status="1"
        >立即送出</view>
        <view
          class="option-chip {{deliveryStatus === 0 ? 'active' : ''}}"
          bindtap="onSelectDelivery"
          data-status="0"
        >选择时间</view>
      </view>
      <view class="sub-row">
        <text class="sub-label">送达时间</text>
        <picker
          wx:if="{{deliveryStatus === 0}}"
          mode="time"
          value="{{pickTime}}"
          bindchange="onPickTime"
        >
          <text class="sub-value link">{{deliveryTimeText}} ></text>
        </picker>
        <text wx:else class="sub-value">{{deliveryTimeText}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">餐具数量</text>
      <view class="option-row">
        <view
          class="option-chip {{tablewareStatus === 1 ? 'active' : ''}}"
          bindtap="onSelectTableware"
          data-status="1"
        >按餐量提供</view>
        <view
          class="option-chip {{tablewareStatus === 0 ? 'active' : ''}}"
          bindtap="onSelectTableware"
          data-status="0"
        >选择数量</view>
      </view>
      <view class="sub-row">
        <text class="sub-label">餐具</text>
        <text wx:if="{{tablewareStatus === 1}}" class="sub-value">
          {{tablewareNumber}} 份（按餐量）
        </text>
        <view wx:else class="stepper">
          <view
            class="stepper-btn {{tablewareNumber <= 0 ? 'disabled' : ''}}"
            catchtap="onTablewareMinus"
          >-</view>
          <text class="stepper-value">{{tablewareNumber}}</text>
          <view
            class="stepper-btn {{tablewareNumber >= 99 ? 'disabled' : ''}}"
            catchtap="onTablewarePlus"
          >+</view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">订单备注</text>
      <input
        class="remark-input"
        placeholder="口味、偏好等要求"
        value="{{remark}}"
        bindinput="onRemarkInput"
      />
    </view>

    <view class="section">
      <text class="section-title">支付方式</text>
      <view class="option-row">
        <view
          class="option-chip {{payMethod === 1 ? 'active' : ''}}"
          bindtap="onSelectPayMethod"
          data-method="1"
        >微信支付</view>
        <view
          class="option-chip {{payMethod === 2 ? 'active' : ''}}"
          bindtap="onSelectPayMethod"
          data-method="2"
        >支付宝</view>
      </view>
    </view>

    <view class="section summary">
      <view class="row">
        <text>商品金额</text>
        <text>¥{{totalAmountText}}</text>
      </view>
      <view class="row">
        <text>打包费</text>
        <text>¥{{packAmountText}}</text>
      </view>
      <view class="row total">
        <text>合计</text>
        <text>¥{{payAmountText}}</text>
      </view>
    </view>
    </scroll-view>

    <view class="submit-bar">
      <view class="submit-amount">
        合计 <text class="submit-amount-value">¥{{payAmountText}}</text>
      </view>
      <view
        class="submit-btn {{submitting ? 'disabled' : ''}}"
        bindtap="onSubmitOrder"
      >{{submitting ? '提交中...' : '提交并支付'}}</view>
    </view>
  </block>
</view>
