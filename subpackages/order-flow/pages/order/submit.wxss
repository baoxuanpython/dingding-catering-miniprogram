.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}
.address-section {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  position: relative;
}
.consignee {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}
.address-detail {
  font-size: 26rpx;
  color: #666666;
  display: block;
}
.placeholder {
  color: #999999;
  font-size: 28rpx;
}
.arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #cccccc;
}
.cart-items {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.cart-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}
.form-section {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.label {
  width: 120rpx;
  font-size: 28rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eeeeee;
  padding: 10rpx 0;
}
.summary {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.row.total {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b35;
  border-top: 1rpx solid #eeeeee;
  margin-top: 12rpx;
  padding-top: 20rpx;
}
.submit-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #ff6b35;
  color: #ffffff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 0;
}
