.container {
  min-height: 100vh;
  background-color: var(--color-bg-page, #f0f7f4);
  padding-bottom: 150rpx;
}
.form {
  background-color: var(--color-bg-card, #ffffff);
  padding: 8rpx 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  border: none;
  outline: none;
}
.textarea {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  min-height: 120rpx;
  border: none;
  outline: none;
}
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
}
.switch-item {
  justify-content: space-between;
}
.save-btn {
  position: fixed;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 46rpx;
  border: none;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.save-btn::after {
  border: none;
}
