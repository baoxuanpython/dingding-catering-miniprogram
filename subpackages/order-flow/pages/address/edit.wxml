<navigation-bar title="{{isEdit ? '编辑地址' : '新增地址'}}" color="#1a3a2a" background="#FFF"></navigation-bar>
<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="label">收件人 *</text>
      <input class="input" placeholder="请输入收件人姓名" value="{{form.consignee}}" bindinput="onInput" data-field="consignee" />
    </view>

    <view class="form-item">
      <text class="label">手机号 *</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
    </view>

    <view class="form-item">
      <text class="label">性别 *</text>
      <radio-group bindchange="onRadioChange">
        <label><radio value="男" checked="{{form.sex === '男'}}" /> 男</label>
        <label><radio value="女" checked="{{form.sex === '女'}}" /> 女</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="picker-value">{{regionText}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">详细地址 *</text>
      <textarea class="textarea" placeholder="请输入详细地址（街道、门牌号等）" value="{{form.detail}}" bindinput="onInput" data-field="detail"></textarea>
    </view>

    <view class="form-item">
      <text class="label">标签</text>
      <input class="input" placeholder="如：家、公司" value="{{form.label}}" bindinput="onInput" data-field="label" />
    </view>

    <view class="form-item switch-item">
      <text class="label">设为默认地址</text>
      <switch checked="{{form.isDefault === 1}}" bindchange="onSwitchChange" color="#4caf50"></switch>
    </view>
  </view>

  <button class="save-btn" bindtap="onSave">保存</button>
</view>
