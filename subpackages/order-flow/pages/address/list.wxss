.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}
.address-card {
  background-color: #ffffff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}
.address-info {
  margin-bottom: 20rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.consignee {
  font-size: 30rpx;
  font-weight: bold;
}
.phone {
  font-size: 28rpx;
  color: #666666;
}
.default-tag {
  font-size: 22rpx;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.detail {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
.actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
  font-size: 26rpx;
  color: #666666;
}
.delete {
  color: #ff6b35;
}
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
.add-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #ff6b35;
  color: #ffffff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 0;
}
