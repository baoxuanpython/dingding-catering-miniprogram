.container {
  min-height: 100vh;
  background-color: var(--color-bg-page, #f0f7f4);
  padding-bottom: 150rpx;
}
.address-card {
  background-color: var(--color-bg-card, #ffffff);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.address-info {
  margin-bottom: 20rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.consignee {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
}
.phone {
  font-size: 28rpx;
  color: var(--color-text-secondary, #6b8f71);
}
.default-tag {
  font-size: 22rpx;
  color: var(--color-primary-dark, #388e3c);
  background-color: var(--color-primary-bg, #e8f5e9);
  border: 1rpx solid var(--color-primary, #4caf50);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.detail {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
  line-height: 1.5;
}
.actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light, #e8f5e9);
  font-size: 26rpx;
  color: var(--color-text-primary, #1a3a2a);
}
.delete {
  color: var(--color-danger, #f44336);
}
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--color-text-secondary, #6b8f71);
  font-size: 28rpx;
}
.add-btn {
  position: fixed;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 46rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
