page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page, #f0f7f4);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  height: auto;
}
.load-failed {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.load-failed-text {
  font-size: 30rpx;
  color: var(--color-text-secondary, #6b8f71);
  margin-bottom: 32rpx;
}
.load-failed-btn {
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  color: #ffffff;
  background-color: var(--color-primary, #4caf50);
  border-radius: 40rpx;
}
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  background-color: var(--color-bg-card, #ffffff);
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.avatar-btn {
  border: none;
  background: transparent;
  padding: 0;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar.placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-primary-bg, #e8f5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  text-align: center;
}
.form {
  background-color: var(--color-bg-card, #ffffff);
  padding: 0 30rpx;
  margin: 0 20rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  border: none;
  outline: none;
}
/* radio-group 与 label 在 Skyline 下默认按块级排列，会竖着堆叠，需显式指定横向弹性布局 */
.radio-group {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 60rpx;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
}
.radio-icon {
  margin-right: 12rpx;
}
.save-btn {
  flex: none;
  margin: 0 16rpx 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 46rpx;
  border: none;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.save-btn::after {
  border: none;
}
