.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  background-color: #ffffff;
  margin-bottom: 20rpx;
}
.avatar-btn {
  border: none;
  background: transparent;
  padding: 0;
  line-height: normal;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar.placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}
.form {
  background-color: #ffffff;
  padding: 0 30rpx;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  border: none;
  outline: none;
}
.save-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #ff6b35;
  color: #ffffff;
  font-size: 32rpx;
  text-align: center;
  border-radius: 0;
}
