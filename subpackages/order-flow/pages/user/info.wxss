.container {
  min-height: 100vh;
  background-color: var(--color-bg-page, #f0f7f4);
  padding-bottom: 150rpx;
}
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  background-color: var(--color-bg-card, #ffffff);
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.avatar-btn {
  border: none;
  background: transparent;
  padding: 0;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar.placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-primary-bg, #e8f5e9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  text-align: center;
}
.form {
  background-color: var(--color-bg-card, #ffffff);
  padding: 0 30rpx;
  margin: 0 20rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  border: none;
  outline: none;
}
.save-btn {
  position: fixed;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 46rpx;
  border: none;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}
.save-btn::after {
  border: none;
}
