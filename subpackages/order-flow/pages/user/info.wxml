<navigation-bar title="个人信息" color="#1a3a2a" background="#FFF"></navigation-bar>
<view class="container">
  <view wx:if="{{loadFailed}}" class="load-failed">
    <text class="load-failed-text">资料加载失败</text>
    <view class="load-failed-btn" bindtap="onRetryLoad">重新加载</view>
  </view>

  <scroll-view wx:else class="scroll-area" scroll-y enhanced bounces>
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{uploading}}">
      <image 
        wx:if="{{form.avatar}}" 
        src="{{form.avatar}}" 
        mode="aspectFill" 
        class="avatar"
      ></image>
      <view wx:else class="avatar placeholder">
        <text>{{uploading ? '上传中...' : '点击设置头像'}}</text>
      </view>
    </button>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">昵称</text>
      <input 
        type="nickname" 
        class="input" 
        placeholder="请输入昵称" 
        value="{{form.name}}" 
        bindinput="onInputNickname" 
      />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input 
        type="number" 
        class="input" 
        placeholder="请输入手机号" 
        value="{{form.phone}}" 
        bindinput="onInput" 
        data-field="phone" 
        maxlength="11" 
      />
    </view>

    <view class="form-item">
      <text class="label">性别</text>
      <radio-group class="radio-group" bindchange="onRadioChange" >
        <label class="radio-item"><radio class="radio-icon" value="男" checked="{{form.sex === '男'}}" /> 男</label>
        <label class="radio-item"><radio class="radio-icon" value="女" checked="{{form.sex === '女'}}" /> 女</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="label">身份证号</text>
      <input 
        class="input" 
        placeholder="请输入身份证号（选填）" 
        value="{{form.idNumber}}" 
        bindinput="onInput" 
        data-field="idNumber" 
        maxlength="18" 
      />
    </view>
  </view>
  </scroll-view>

  <button wx:if="{{!loadFailed}}" class="save-btn" bindtap="onSave">保存</button>
</view>
