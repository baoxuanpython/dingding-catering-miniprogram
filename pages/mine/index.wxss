page {
  background-color: var(--color-bg-page, #f0f7f4);
}

.container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx;
  box-sizing: border-box;
}

.user-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.avatar {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-bg-page, #f0f7f4);
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-primary-bg, #e8f5e9);
}

.avatar-icon {
  width: 72rpx;
  height: 72rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.user-header .arrow {
  flex: none;
  margin-left: 16rpx;
}

.profile-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background-color: var(--color-primary-bg, #e8f5e9);
  border-radius: 16rpx;
}

.profile-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-primary-dark, #388e3c);
}

.profile-tip-action {
  flex: none;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-primary-dark, #388e3c);
}

.menu-list {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.order-entry .menu-item {
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx;
  font-size: 30rpx;
  color: var(--color-text-primary, #1a3a2a);
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
}

.menu-item:last-child {
  border-bottom: none;
}

.logout-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 32rpx;
  font-size: 30rpx;
  color: var(--color-danger, #f44336);
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.arrow {
  flex: none;
  font-size: 28rpx;
  color: var(--color-text-disabled, #bdbdbd);
}

.hover-fade {
  opacity: 0.7;
}
