<navigation-bar title="我的" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <view class="user-header">
    <image 
      wx:if="{{userInfo && userInfo.avatar}}" 
      src="{{userInfo.avatar}}" 
      class="avatar"
      mode="aspectFill"
    ></image>
    <view wx:else class="avatar placeholder">👤</view>
    <text class="nickname">{{userInfo ? (userInfo.name || '未设置昵称') : '未登录'}}</text>
  </view>
  
  <view class="menu-list">
    <view class="menu-item" bindtap="onTapEditProfile">
      <text>个人信息</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="onTapAddress">
      <text>地址管理</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item logout" bindtap="onTapLogout">
      <text>退出登录</text>
    </view>
  </view>
</view>
