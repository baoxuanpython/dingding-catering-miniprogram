<navigation-bar title="我的订单" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <scroll-view scroll-x class="status-tabs">
    <view 
      wx:for="{{statusOptions}}" 
      wx:key="value"
      class="tab-item {{status === item.value ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </scroll-view>
  
  <scroll-view scroll-y class="order-list">
    <view wx:for="{{orderList}}" wx:key="id" class="order-card" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-number">订单号：{{item.number}}</text>
        <text class="order-status">{{item.status === 1 ? '待付款' : item.status === 2 ? '待接单' : item.status === 3 ? '已接单' : item.status === 4 ? '派送中' : item.status === 5 ? '已完成' : item.status === 6 ? '已取消' : '已退款'}}</text>
      </view>
      <view class="order-dishes">{{item.orderDishes}}</view>
      <view class="order-footer">
        <text class="order-time">{{item.orderTime}}</text>
        <text class="order-amount">¥{{item.amount}}</text>
      </view>
    </view>
    
    <view wx:if="{{orderList.length === 0}}" class="empty-orders">
      <text>暂无订单</text>
    </view>
  </scroll-view>
</view>
