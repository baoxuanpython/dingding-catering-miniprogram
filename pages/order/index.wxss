page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page, #f0f7f4);
}

.status-tabs {
  white-space: nowrap;
  padding: 20rpx;
  box-sizing: border-box;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
  border-radius: 32rpx;
  background-color: var(--color-bg-card, #ffffff);
}

.tab-item.active {
  color: #ffffff;
  background-color: var(--color-primary, #4caf50);
}

.order-list {
  flex: 1;
  min-height: 0;
  height: auto;
}

.order-card {
  margin: 20rpx;
  padding: 24rpx;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-number {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
}

.order-status.status-1 {
  color: var(--color-danger, #f44336);
}

.order-status.status-2,
.order-status.status-3,
.order-status.status-4 {
  color: var(--color-primary-dark, #388e3c);
}

.order-status.status-5 {
  color: var(--color-text-secondary, #6b8f71);
}

.order-status.status-6,
.order-status.status-7 {
  color: var(--color-text-disabled, #bdbdbd);
}

.order-dishes {
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border-light, #e8f5e9);
}

.order-time {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.order-amount {
  font-size: 32rpx;
  color: var(--color-price, #d32f2f);
  font-weight: bold;
}

.order-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  padding-top: 16rpx;
}

.action-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  color: var(--color-text-primary, #1a3a2a);
  border: 1rpx solid var(--color-border, #c8e6c9);
  border-radius: 30rpx;
  box-sizing: border-box;
}

.action-btn.primary {
  color: var(--color-primary, #4caf50);
  border-color: var(--color-primary, #4caf50);
}

.page-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.empty-orders {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: var(--color-text-secondary, #6b8f71);
  font-size: 28rpx;
}

.empty-text {
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 56rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.list-end-tip {
  padding: 30rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-disabled, #bdbdbd);
}
