.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.status-tabs {
  white-space: nowrap;
  background-color: #ffffff;
  padding: 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.tab-item.active {
  color: #ffffff;
  background-color: #ff6b35;
}

.order-list {
  height: calc(100vh - 140rpx);
}

.order-card {
  margin: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-number {
  font-size: 26rpx;
  color: #666666;
}

.order-status {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: bold;
}

.order-dishes {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #eeeeee;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
}

.order-amount {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.empty-orders {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999999;
  font-size: 28rpx;
}
