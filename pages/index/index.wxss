page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page, #f0f7f4);
}

.container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  padding: 0;
  box-sizing: border-box;
}

.shop-bar {
  flex: none;
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx 8rpx;
}

.shop-main {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.shop-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
}

.shop-status {
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.shop-status.open {
  color: var(--color-primary-dark, #388e3c);
  background-color: var(--color-primary-bg, #e8f5e9);
}

.shop-status.closed {
  color: var(--color-text-secondary, #6b8f71);
  background-color: var(--color-bg-disabled, #e0e0e0);
}

.shop-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.shop-closed-tip {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #a15c00;
  background-color: #fff4e5;
}

.search-bar {
  flex: none;
  padding: 12rpx 24rpx 16rpx;
}

.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 34rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  font-size: 26rpx;
  color: var(--color-text-primary, #1a3a2a);
}

.search-clear {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  padding-left: 12rpx;
}

.main-content {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-height: 0;
  padding: 0 16rpx 16rpx;
  box-sizing: border-box;
}

.category-list {
  flex: none;
  width: 180rpx;
  margin-right: 16rpx;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
  overflow: hidden;
}

.category-item {
  padding: 30rpx 16rpx;
  font-size: 28rpx;
  text-align: center;
  color: var(--color-text-secondary, #6b8f71);
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
}

.category-item.active {
  background-color: var(--color-primary-bg, #e8f5e9);
  border-left-color: var(--color-primary, #4caf50);
  color: var(--color-primary-dark, #388e3c);
  font-weight: bold;
}

.product-list {
  flex: 1;
  min-width: 0;
  height: 100%;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
  overflow: hidden;
}

.state-tip {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.state-retry {
  color: var(--color-primary, #4caf50);
}

.product-rows {
  padding-bottom: 20rpx;
}

.list-end-tip {
  padding: 30rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-disabled, #bdbdbd);
}

.product-row {
  display: flex;
  flex-direction: row;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
  box-sizing: border-box;
}

.row-image-wrap {
  position: relative;
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.row-image {
  width: 168rpx;
  height: 168rpx;
  background-color: var(--color-bg-page, #f0f7f4);
}

.product-row.sold-out .row-image {
  opacity: 0.45;
}

.row-sold-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background-color: var(--color-mask, rgba(0, 0, 0, 0.55));
}

.row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.row-price {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-price, #d32f2f);
}

.product-row.sold-out .row-name,
.product-row.sold-out .row-desc,
.product-row.sold-out .row-price {
  color: var(--color-text-disabled, #bdbdbd);
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ffffff;
  border-radius: 50%;
  background-color: var(--color-primary, #4caf50);
}

.add-btn.disabled {
  background-color: var(--color-bg-disabled, #e0e0e0);
}

.cart-bar {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 104rpx;
  margin: 0 16rpx 16rpx;
  padding-left: 24rpx;
  box-sizing: border-box;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.cart-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cart-hover {
  opacity: 0.7;
}

.cart-icon-wrap {
  position: relative;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  color: #ffffff;
  text-align: center;
  border-radius: 16rpx;
  background-color: var(--color-primary, #4caf50);
}

.cart-summary {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.cart-total {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-price, #d32f2f);
}

.cart-empty-tip {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.checkout-btn {
  flex: none;
  height: 76rpx;
  line-height: 76rpx;
  margin-right: 16rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: var(--color-primary, #4caf50);
  border-radius: 40rpx;
}

.checkout-btn.disabled {
  background-color: var(--color-bg-disabled, #e0e0e0);
}
