<navigation-bar title="完善信息" />

<view class="page">
  <view class="card">
    <view class="card__title">完善您的个人信息</view>
    <view class="card__desc">完善后下单时可自动填充基本信息</view>

    <view class="avatar-wrap">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          class="avatar-img"
          src="{{ avatarUrl || '/images/default-avatar.png' }}"
          mode="aspectFill"
        />
      </button>
      <view class="avatar-tip">点击设置头像</view>
    </view>

    <view class="nickname-wrap">
      <view class="label">昵称</view>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{ nickname }}"
        bindinput="onNicknameInput"
      />
    </view>

    <button
      class="save-btn"
      type="primary"
      loading="{{ saving }}"
      disabled="{{ saving }}"
      bindtap="onSave"
    >
      保存
    </button>

    <view class="skip-btn" bindtap="onSkip">
      暂不完善，直接进入
    </view>
  </view>
</view>
