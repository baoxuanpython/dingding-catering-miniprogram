.page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.card__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}

.card__desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 48rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #eee;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.nickname-wrap {
  margin-bottom: 48rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  background: #ff6b35;
  color: #fff;
  border: none;
}

.save-btn[disabled] {
  opacity: 0.6;
}

.skip-btn {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 32rpx;
  padding: 8rpx 0;
}
