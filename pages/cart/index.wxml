<navigation-bar title="购物车" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <view wx:if="{{cartList.length > 0}}">
    <view wx:for="{{cartList}}" wx:key="id" class="cart-item">
      <image src="{{item.image}}" mode="aspectFill" class="item-image"></image>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <view class="item-bottom">
          <text class="item-price">¥{{item.amount}}</text>
          <view class="quantity-control">
            <text class="qty-btn">-</text>
            <text class="qty-num">{{item.number}}</text>
            <text class="qty-btn">+</text>
          </view>
        </view>
      </view>
    </view>
    
    <view class="cart-footer">
      <view class="total-info">
        <text>共 {{totalCount}} 件</text>
        <text class="total-amount">合计：¥{{totalAmount}}</text>
      </view>
      <button class="checkout-btn">去结算</button>
    </view>
  </view>
  
  <view wx:else class="empty-cart">
    <text>购物车是空的</text>
  </view>
</view>
