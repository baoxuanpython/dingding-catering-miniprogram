page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page, #f0f7f4);
  box-sizing: border-box;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  height: auto;
}

.state-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.state-retry {
  color: var(--color-primary, #4caf50);
}

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx 8rpx;
}

.cart-count {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.clean-btn {
  font-size: 24rpx;
  color: var(--color-text-primary, #1a3a2a);
}

.cart-item {
  display: flex;
  background-color: var(--color-bg-card, #ffffff);
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: var(--color-bg-page, #f0f7f4);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1a3a2a);
  line-height: 40rpx;
}

.item-delete {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #6b8f71);
  padding: 4rpx 0 4rpx 16rpx;
}

.item-flavor {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.item-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price-wrap {
  display: flex;
  align-items: baseline;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-price, #d32f2f);
}

.item-unit {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
  border: 1rpx solid var(--color-border, #c8e6c9);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.qty-btn.disabled {
  color: var(--color-text-disabled, #bdbdbd);
  border-color: var(--color-border-light, #e8f5e9);
}

.qty-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-primary, #1a3a2a);
}

.cart-footer {
  flex: none;
  margin: 0 16rpx 16rpx;
  height: 104rpx;
  background-color: var(--color-bg-card, #ffffff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  box-shadow: var(--color-shadow-light, 0 2px 12px rgba(76, 175, 80, 0.08));
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  margin-right: 12rpx;
}

.total-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-price, #d32f2f);
}

.checkout-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 40rpx;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 56rpx;
  font-size: 26rpx;
  color: var(--color-primary, #4caf50);
  border: 1rpx solid var(--color-primary, #4caf50);
  border-radius: 40rpx;
}
