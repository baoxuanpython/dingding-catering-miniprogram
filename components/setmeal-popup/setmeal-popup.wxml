<view wx:if="{{visible}}" class="popup-root">
  <view class="popup-mask" bindtap="onClose"></view>

  <view class="popup-panel" catchtap="noop">
    <view class="popup-header">
      <image class="popup-cover" src="{{coverImage}}" mode="aspectFill"></image>
      <view class="popup-head-info">
        <text class="popup-name">{{setmealName}}</text>
        <text class="popup-desc">{{setmealDesc}}</text>
        <text class="popup-price">{{setmealPriceText}}</text>
      </view>
      <view class="popup-close" bindtap="onClose">✕</view>
    </view>

    <scroll-view class="popup-body" scroll-y enhanced bounces>
      <view wx:if="{{loading}}" class="popup-empty">套餐内容加载中...</view>

      <view wx:elif="{{loadFailed}}" class="popup-empty" bindtap="onRetry">
        加载失败，点击重试
      </view>

      <view wx:else>
        <view wx:for="{{dishItems}}" wx:for-index="di" wx:key="dishId" class="dish-block">
          <view class="dish-head">
            <text class="dish-name">{{item.dishName}}</text>
            <text class="dish-copies">× {{item.copies}}</text>
          </view>

          <view wx:for="{{item.groups}}" wx:for-item="group" wx:for-index="gi" wx:key="flavorId" class="flavor-group">
            <text class="flavor-name">{{group.name}}</text>
            <view class="flavor-values">
              <view
                wx:for="{{group.values}}"
                wx:for-item="value"
                wx:for-index="vi"
                wx:key="*this"
                class="flavor-chip {{vi === group.selectedIndex ? 'active' : ''}}"
                catchtap="onSelectFlavor"
                data-di="{{di}}"
                data-fid="{{group.flavorId}}"
                data-vi="{{vi}}"
              >{{value}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{dishItems.length === 0}}" class="popup-empty">
          该套餐内菜品暂无可选口味
        </view>
      </view>
    </scroll-view>

    <view class="popup-footer">
      <view class="quantity-control">
        <view
          class="qty-btn {{quantity <= 1 ? 'disabled' : ''}}"
          catchtap="onMinus"
        >-</view>
        <text class="qty-value">{{quantity}}</text>
        <view
          class="qty-btn {{quantity >= 99 ? 'disabled' : ''}}"
          catchtap="onPlus"
        >+</view>
      </view>
      <view class="popup-add {{adding ? 'disabled' : ''}}" catchtap="onAdd">
        加入购物车 ¥{{totalText}}
      </view>
    </view>
  </view>
</view>
