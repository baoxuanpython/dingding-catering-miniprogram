.popup-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}
.popup-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-mask, rgba(0, 0, 0, 0.55));
  animation: popup-fade-in 0.2s ease;
}
.popup-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 80%;
  background-color: var(--color-bg-card, #ffffff);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: popup-slide-up 0.26s ease;
}
@keyframes popup-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes popup-slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
.popup-header {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--color-border-light, #e8f5e9);
}
.popup-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background-color: var(--color-bg-page, #f0f7f4);
  flex-shrink: 0;
}
.popup-head-info {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 40rpx;
  display: flex;
  flex-direction: column;
}
.popup-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-primary, #1a3a2a);
  margin-bottom: 10rpx;
}
.popup-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b8f71);
  margin-bottom: 12rpx;
}
.popup-price {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-price, #d32f2f);
}
.popup-close {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary, #6b8f71);
}
.popup-body {
  flex: 1;
  min-height: 0;
  padding: 30rpx 30rpx 10rpx;
  box-sizing: border-box;
}
.popup-empty {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
  text-align: center;
  padding: 40rpx 0;
}
.flavor-group {
  margin-bottom: 24rpx;
}
.flavor-name {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b8f71);
  display: block;
  margin-bottom: 12rpx;
}
.flavor-values {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.flavor-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-primary, #1a3a2a);
  background-color: var(--color-bg-page, #f0f7f4);
  border: 1rpx solid var(--color-bg-page, #f0f7f4);
  border-radius: 30rpx;
}
.flavor-chip.active {
  color: var(--color-primary-dark, #388e3c);
  background-color: var(--color-primary-bg, #e8f5e9);
  border-color: var(--color-primary, #4caf50);
}
.popup-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid var(--color-border-light, #e8f5e9);
}
.quantity-control {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  border: 1rpx solid var(--color-border, #c8e6c9);
  border-radius: 8rpx;
  font-size: 32rpx;
  color: var(--color-text-primary, #1a3a2a);
  box-sizing: border-box;
}
.qty-btn.disabled {
  color: var(--color-text-disabled, #bdbdbd);
  border-color: var(--color-border-light, #e8f5e9);
}
.qty-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text-primary, #1a3a2a);
}
.popup-add {
  height: 76rpx;
  line-height: 76rpx;
  background-color: var(--color-primary, #4caf50);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0 48rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
}
.popup-add.disabled {
  background-color: var(--color-bg-disabled, #e0e0e0);
}
